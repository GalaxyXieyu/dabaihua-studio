{
  "name": "dabaihua-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "prod:start": "bash scripts/serve-prod.sh start",
    "prod:stop": "bash scripts/serve-prod.sh stop",
    "prod:status": "bash scripts/serve-prod.sh status",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/ledger.test.mjs tests/nav-slim.test.mjs tests/nav-sidebar.test.mjs tests/content.test.mjs tests/cards-api.test.mjs tests/brief-materials.test.mjs tests/assistant-events.test.mjs tests/assistant-event-log.test.mjs tests/brief-response-notify.test.mjs tests/review-notify.test.mjs tests/brief-pipeline.test.mjs tests/outline-structured.test.mjs tests/brief-ui.test.mjs tests/outline-ui.test.mjs tests/articles-access.test.mjs tests/article-push-v2.test.mjs tests/cli-article.test.mjs tests/private-data.test.mjs tests/session-remember.test.mjs tests/typography.test.mjs tests/strategy-page.test.mjs tests/seal-core.test.mjs tests/seal-static.test.mjs tests/seal-player.test.mjs tests/seal-today.test.mjs tests/seal-inpage.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "digest": "node scripts/daily-ai-digest.mjs",
    "daily:build": "node scripts/build-daily.mjs",
    "daily:upload": "bash scripts/upload-daily.sh",
    "cards:import": "node scripts/cards-import-handbook.mjs",
    "draft": "node scripts/draft-article.mjs",
    "articles:sync": "node scripts/sync-articles.mjs",
    "articles:watch": "node scripts/sync-articles.mjs --watch",
    "publish:draft": "node scripts/publish-draft.mjs",
    "publish-review": "node scripts/publish-review.mjs",
    "brief": "node scripts/brief.mjs",
    "materials": "node scripts/materials.mjs",
    "kb:install": "npm --prefix scripts/topic-kb install",
    "kb:ingest": "node --no-warnings scripts/topic-kb/ingest.mjs",
    "kb:related": "node --no-warnings scripts/topic-kb/related.mjs",
    "kb:merge": "node --no-warnings scripts/topic-kb/merge.mjs",
    "kb:brief": "node --no-warnings scripts/topic-kb/to-brief.mjs",
    "topics:daily": "node --no-warnings scripts/topic-kb/daily.mjs",
    "events:doc": "node scripts/gen-assistant-events-doc.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "mermaid": "^12.1.0",
    "next": "16.2.10",
    "postcss": "8.5.19",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.0",
    "@cloudflare/workers-types": "5.20260717.1",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "linkedom": "^0.18.13",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.111.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "type": "module"
}
