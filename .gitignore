# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/.wechat-runtime/

# 采集端（collector/）运行态
/collector/node/
/collector/logs/
/collector/**/__pycache__/
*.pyc
/collector/*.bak
/collector/.qr-push-state
/collector/.qr-push-state.gentle
/collector/.workbuddy/

# Project-local MCP credentials (use the tracked example files as templates)
/.mcp.json
/.codex/config.toml

# 职业私密数据，由 career-site/build_data.py 生成，只随 rsync 部署，不进公开仓库
/content/career/career.json

# 日报私密数据，由 scripts/build-daily.mjs 生成，只本机构建时读取，不进公开仓库
/content/daily/
