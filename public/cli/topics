EVENTS_CURSOR = CONFIG_DIR / "events-cursor.json"


def _events_load_cursor():
    """读本机游标（键 = endpoint）；文件不存在 / 均坏 / 值非法时返回 None。"""
    try:
        data = json.loads(EVENTS_CURSOR.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    value = data.get(endpoint())
    if isinstance(value, int) and value > 0:
        return value
    return None


def _events_save_cursor(next_after_id):
    """把 nextAfterId 存进游标文件（键 = endpoint）；写失败静默，不影响输出。"""
    try:
        data = json.loads(EVENTS_CURSOR.read_text())
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    data[endpoint()] = int(next_after_id)
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        EVENTS_CURSOR.write_text(json.dumps(data, ensure_ascii=False, indent=1))
    except OSError:
        pass


def _events_local_time(iso):
    """createdAt（ISO）→ +08:00 的 YYYY-MM-DD HH:MM:SS；解析失败原样返回。"""
    text = str(iso or "")
    try:
        moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return text
    return moment.astimezone(timezone(timedelta(hours=8))).strftime("%Y-%m-%d %H:%M:%S")


def _feedback_local_time(iso):
    """submittedAt（ISO）→ +08:00 的 YYYY-MM-DD HH:MM；解析失败原样返回。"""
    text = str(iso or "")
    try:
        moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return text
    return moment.astimezone(timezone(timedelta(hours=8))).strftime("%Y-%m-%d %H:%M")


