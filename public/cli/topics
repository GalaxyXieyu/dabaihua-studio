ITCH_TARGET_FLAGS = {
    "item": "item", "annotation": "annotation", "conversation": "conversation",
    "project": "project", "related_itch": "itch", "topic": "topic",
}


def _itch_target(args):
    targets = [(target_type, getattr(args, flag)) for flag, target_type in ITCH_TARGET_FLAGS.items()
               if getattr(args, flag) is not None]
    if len(targets) > 1:
        sys.exit("一次只能关联一个目标")
    return targets[0] if targets else (None, None)


def _json_payload(path):
    if not path:
        sys.exit("这个动作需要 --file <JSON文件>；使用 --file - 可从标准输入读取")
    try:
        content = sys.stdin.read() if path == "-" else Path(path).read_text()
        payload = json.loads(content)
    except (OSError, json.JSONDecodeError) as error:
        sys.exit(f"无法读取 JSON: {error}")
    if not isinstance(payload, dict):
        sys.exit("JSON 顶层必须是对象")
    return payload


def _print_itch_detail(itch):
    print(f"#{itch.get('id')}  [{itch.get('status')}]  触发 {itch.get('feltCount', 1)} 次")
    print(itch.get("body", ""))
    if itch.get("note"):
        print(f"备注: {itch['note']}")
    print(f"首次: {str(itch.get('firstFeltAt', ''))[:16]}  最近: {str(itch.get('lastFeltAt', ''))[:16]}")
    events = itch.get("events") or []
    if events:
        print("\n触发与记录:")
        for event in events:
            body = f" · {event['body']}" if event.get("body") else ""
            print(f"  {str(event.get('createdAt', ''))[:16]}  {event.get('type')}{body}")
    links = itch.get("links") or []
    if links:
        print("\n关联:")
        for link in links:
            note = f" · {link['note']}" if link.get("note") else ""
            print(f"  #{link.get('id')}  {link.get('relation')} -> {link.get('targetType')}:{link.get('targetId')}{note}")
    explorations = itch.get("explorations") or []
    if explorations:
        print("\n探索:")
        for exploration in explorations:
            research_count = sum(bool(exploration.get(key)) for key in (
                "questionTree", "materialMap", "counterEvidence", "evidenceGaps"))
            print(f"  #{exploration.get('id')}  第 {exploration.get('round')} 轮 · {exploration.get('status')} · {research_count}/4 类研究产物")
    directions = itch.get("directions") or []
    if directions:
        print("\n方向:")
        for direction in directions:
            print(f"  #{direction.get('id')}  [{direction.get('status')}/{direction.get('confidence')}] {direction.get('claim', '')}")


def cmd_itch(args):
    values = list(args.values or [])
    action = values[0] if values else "list"

    if action == "list":
        query = ""
        if args.status:
            query = "?status=" + urllib.parse.quote(args.status)
        data = request("/api/itches" + query)
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
            return
        rows = data.get("itches", [])
        if not rows:
            print("（没有匹配的心结）")
            return
        for itch in rows:
            print(f"[{itch['id']:>3}] {itch.get('status', 'open'):<8} ×{itch.get('feltCount', 1):<3} {itch.get('body', '')}")
            print(f"      最近 {str(itch.get('lastFeltAt', ''))[:16]} · {itch.get('eventCount', 0)} 条记录 · {itch.get('linkCount', 0)} 个关联")
        print(f"\n共 {len(rows)} 条 · superme itch show <id> 查看")
        return

    if action == "show":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch show <id>")
        data = request(f"/api/itches/{values[1]}")
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            _print_itch_detail(data.get("itch", {}))
        return

    if action == "feel":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit('用法: superme itch feel <id> "为什么又想到它"')
        note = args.note or " ".join(values[2:]).strip()
        if not note:
            sys.exit("再次触发时请写一句当时发生了什么")
        data = request(f"/api/itches/{values[1]}/events", "POST", {"type": "resurfaced", "body": note})
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            print(f"心结 #{values[1]} 已记录一次再次触发")
        return

    if action == "link":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch link <id> --item <文章ID>")
        target_type, target_id = _itch_target(args)
        if target_type is None:
            sys.exit("至少指定一个关联目标，例如 --item <文章ID>")
        data = request(f"/api/itches/{values[1]}/links", "POST", {
            "targetType": target_type,
            "targetId": str(target_id),
            "relation": args.relation,
            "note": args.note,
        })
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            suffix = "（已存在）" if data.get("existing") else ""
            print(f"心结 #{values[1]} 已关联 {target_type}:{target_id}{suffix}")
        return

    if action == "refine":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch refine <id> --file exploration.json")
        payload = _json_payload(args.file) if args.file else {
            "triggerContext": args.trigger_context,
            "coreConflict": args.core_conflict,
            "personalStake": args.personal_stake,
            "desiredChange": args.desired_change,
            "note": args.note,
        }
        data = request(f"/api/itches/{values[1]}/explorations", "POST", payload)
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            exploration = data.get("exploration", {})
            print(f"心结 #{values[1]} 已创建第 {exploration.get('round')} 轮探索 #{exploration.get('id')}")
        return

    if action == "research":
        if len(values) < 2 or not values[1].isdigit() or args.exploration is None:
            sys.exit("用法: superme itch research <id> --exploration <探索ID> --file research.json")
        payload = _json_payload(args.file)
        data = request(f"/api/itches/{values[1]}/explorations/{args.exploration}", "PATCH", payload)
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            print(f"探索 #{args.exploration} 的研究产物已更新")
        return

    if action == "directions":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch directions <id> [--status candidate]")
        query = "?status=" + urllib.parse.quote(args.status) if args.status else ""
        data = request(f"/api/itches/{values[1]}/directions{query}")
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
            return
        rows = data.get("directions", [])
        if not rows:
            print("（还没有候选方向）")
            return
        for direction in rows:
            print(f"[{direction.get('id'):>3}] {direction.get('status'):<9} {direction.get('confidence'):<6} {direction.get('claim', '')}")
            if direction.get("audience"):
                print(f"      面向: {direction['audience']}")
        return

    if action == "direction":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch direction <id> --file direction.json")
        payload = _json_payload(args.file)
        if args.direction is None:
            data = request(f"/api/itches/{values[1]}/directions", "POST", payload)
        else:
            data = request(f"/api/itches/{values[1]}/directions/{args.direction}", "PATCH", payload)
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            direction = data.get("direction", {})
            print(f"候选方向 #{direction.get('id')} 已保存，当前状态 {direction.get('status')}")
        return

    if action in ("confirm", "reject"):
        if len(values) < 2 or not values[1].isdigit() or args.direction is None:
            sys.exit(f"用法: superme itch {action} <id> --direction <方向ID> [--note 说明]")
        data = request(f"/api/itches/{values[1]}/directions/{args.direction}", "PATCH", {
            "action": action,
            "note": args.note,
        })
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            label = "已由用户确认" if action == "confirm" else "已拒绝"
            print(f"方向 #{args.direction} {label}")
        return

    if action == "archive":
        if len(values) < 2 or not values[1].isdigit():
            sys.exit("用法: superme itch archive <id>")
        data = request(f"/api/itches/{values[1]}", "PATCH", {"status": "archived", "note": args.note})
        if args.json:
            print(json.dumps(data, ensure_ascii=False))
        else:
            print(f"心结 #{values[1]} 已归档")
        return

    target_type, target_id = _itch_target(args)
    body = " ".join(values).strip()
    payload = {"body": body, "note": args.note}
    if target_type is not None:
        payload.update({"sourceType": target_type, "sourceId": str(target_id)})
    data = request("/api/itches", "POST", payload)
    if args.json:
        print(json.dumps(data, ensure_ascii=False))
    else:
        label = "再次触发" if data.get("resurfaced") else "已记录"
        print(f"心结 #{data.get('id')} {label} · superme itch show {data.get('id')} 查看")


