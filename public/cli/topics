def _article_state_load():
    if ARTICLES_STATE.exists():
        try:
            data = json.loads(ARTICLES_STATE.read_text())
            if isinstance(data, dict):
                data.setdefault("version", 1)
                data.setdefault("endpoints", {})
                return data
        except (OSError, json.JSONDecodeError):
            pass
    return {"version": 1, "endpoints": {}}


def _article_state_save(state):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    ARTICLES_STATE.write_text(json.dumps(state, ensure_ascii=False, indent=1))
    try:
        os.chmod(ARTICLES_STATE, 0o600)
    except OSError:
        pass


def _article_state_files(state):
    return state.setdefault("endpoints", {}).setdefault(endpoint(), {}).setdefault("files", {})


def _article_scalar(value):
    text = value.strip().strip("\r")
    if len(text) >= 2 and text[0] == text[-1] and text[0] in ("'", '"'):
        return text[1:-1]
    lowered = text.lower()
    if lowered in ("true", "yes"):
        return True
    if lowered in ("false", "no"):
        return False
    if lowered in ("null", "~"):
        return None
    if text.startswith("[") and text.endswith("]"):
        inner = text[1:-1].strip()
        if not inner:
            return []
        return [_article_scalar(part) for part in inner.split(",")]
    return text


def _parse_frontmatter(text):
    """解析文件开头的 YAML frontmatter，返回 (meta, body)。"""
    if not text.startswith("---"):
        return {}, text
    lines = text.split("\n")
    if lines[0].strip() != "---":
        return {}, text
    end = None
    for index in range(1, len(lines)):
        if lines[index].strip() == "---":
            end = index
            break
    if end is None:
        return {}, text
    meta = {}
    index = 1
    while index < end:
        raw = lines[index].rstrip("\r")
        index += 1
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        match = re.match(r"^([A-Za-z0-9_-]+)\s*:\s*(.*)$", raw)
        if not match:
            continue
        key = match.group(1).strip().lower()
        value = match.group(2)
        if value.strip() == "":
            items = []
            while index < end:
                item_match = re.match(r"^\s*-\s+(.*)$", lines[index].rstrip("\r"))
                if item_match:
                    items.append(_article_scalar(item_match.group(1)))
                    index += 1
                elif not lines[index].strip():
                    index += 1
                else:
                    break
            meta[key] = items if items else None
        else:
            meta[key] = _article_scalar(value)
    return meta, "\n".join(lines[end + 1:])


def _article_title(meta, body, path):
    value = meta.get("title")
    if value is not None and str(value).strip():
        return str(value).strip()
    heading = re.search(r"^#\s+(.+)$", body, re.MULTILINE)
    if heading:
        return heading.group(1).strip()
    return path.stem


def _article_generate_slug(title, key):
    words = re.findall(r"[A-Za-z0-9]+", title.lower())
    slug = re.sub(r"-+", "-", "-".join(words)).strip("-")[:60].strip("-")
    if len(re.sub(r"[^A-Za-z0-9]", "", slug)) < 3:
        return "n-" + hashlib.sha256(key.encode("utf-8")).hexdigest()[:10]
    return slug


def _article_resolve_slug(meta, title, rel_path, abs_path, state_files):
    value = meta.get("slug")
    if value is not None and str(value).strip():
        slug = str(value).strip()
        if not ARTICLE_SLUG_RE.match(slug):
            raise ArticleError("slug 不合法: %r（需匹配 [A-Za-z0-9][A-Za-z0-9._-]{0,120}）" % slug)
        return slug
    record = state_files.get(str(abs_path))
    if record and record.get("slug"):
        return record["slug"]
    # hash 键用「上级目录名/文件名」，避免不同目录里同名文件（如 02-final.md）生成同一个 slug。
    return _article_generate_slug(title, abs_path.parent.name + "/" + abs_path.name)


def _article_tags(meta):
    value = meta.get("tags")
    tags = []
    if isinstance(value, list):
        for item in value:
            if item is not None:
                tags.append(str(item).strip())
    elif isinstance(value, str):
        tags = [part.strip() for part in value.split(",")]
    return [tag for tag in tags if tag]


def _article_status(meta):
    value = meta.get("status")
    if value is None or not str(value).strip():
        return "draft"
    status = str(value).strip().lower()
    if status not in ("draft", "published"):
        raise ArticleError("status 只能是 draft 或 published，得到 %r" % value)
    return status


def _article_date(meta):
    value = meta.get("date")
    if value is None or not str(value).strip():
        return None
    text = str(value).strip()
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", text):
        raise ArticleError("date 必须是 YYYY-MM-DD，得到 %r" % value)
    return text


def _article_is_public(meta, status, cli_public):
    if cli_public:
        return True
    if meta.get("public") is not None:
        return bool(meta.get("public"))
    if status == "published":
        return True
    if "status" in meta and str(meta.get("status")).strip().lower() == "draft":
        return False
    return None


def _article_content_hash(title, status, is_public, date, tags, assets, markdown,
                           article_html=None, qa_report=None, board_topic_id=None, brief=None,
                           stage=None, covers=None):
    public_text = "" if is_public is None else ("true" if is_public else "false")
    lines = [
        ARTICLE_PROTOCOL,
        "title:" + title,
        "status:" + status,
        "public:" + public_text,
        "date:" + (date or ""),
        "tags:" + "\t".join(tags or []),
    ]
    # 可选扩展行（协议 §3）：只在有值时出现，顺序固定 board/brief/html/qa，插在 tags 与 asset 之间。
    if board_topic_id is not None:
        lines.append("board:" + str(board_topic_id))
    if brief:
        lines.append("brief:" + str(brief.get("date", "")) + "\t" + str(brief.get("topicId", "")))
    if article_html:
        lines.append("html:" + hashlib.sha256(article_html.encode("utf-8")).hexdigest())
    if qa_report:
        lines.append("qa:" + hashlib.sha256(qa_report.encode("utf-8")).hexdigest())
    # 阶段扩展行（协议 §3）：跟在 board/brief/html/qa 之后、asset 之前，只在给出时追加。
    if stage:
        round_value = stage.get("round")
        lines.append("stage:%s:%s" % (stage.get("name", ""), "" if round_value is None else str(round_value)))
    for cover in sorted(covers or [], key=lambda item: str(item.get("role", ""))):
        lines.append("cover:%s:%s" % (cover.get("role", ""), cover.get("path", "")))
    for asset in sorted(assets or [], key=lambda item: item["name"]):
        lines.append("asset:" + asset["name"] + " " + asset["sha256"])
    payload = "\n".join(lines) + "\n\n" + markdown
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _article_merge_ranges(ranges):
    merged = []
    for start, end in sorted(ranges):
        if merged and start <= merged[-1][1]:
            merged[-1] = (merged[-1][0], max(merged[-1][1], end))
        else:
            merged.append((start, end))
    return merged


def _article_fenced_ranges(text):
    ranges = []
    lines = text.split("\n")
    position = 0
    fence_char = None
    fence_start = 0
    fence_len = 0
    for line in lines:
        line_start = position
        line_end = position + len(line)
        if fence_char is None:
            match = ARTICLE_FENCE_RE.match(line)
            if match:
                fence_char = match.group(1)[0]
                fence_len = len(match.group(1))
                fence_start = line_start
        else:
            close = re.match(r"^ {0,3}(" + re.escape(fence_char) + r"{" + str(fence_len) + r",})\s*$", line)
            if close:
                ranges.append((fence_start, line_end))
                fence_char = None
        position = line_end + 1
    if fence_char is not None:
        ranges.append((fence_start, len(text)))
    return ranges


def _article_inline_code_ranges(text):
    ranges = []
    length = len(text)
    index = 0
    while index < length:
        if text[index] != "`":
            index += 1
            continue
        run_end = index
        while run_end < length and text[run_end] == "`":
            run_end += 1
        run = run_end - index
        search = run_end
        closing = None
        while search < length:
            if text[search] == "`":
                close_end = search
                while close_end < length and text[close_end] == "`":
                    close_end += 1
                if close_end - search == run:
                    closing = close_end
                    break
                search = close_end
            else:
                search += 1
        if closing is None:
            index = run_end
        else:
            ranges.append((index, closing))
            index = closing
    return ranges


def _article_protected_ranges(text):
    return _article_merge_ranges(_article_fenced_ranges(text) + _article_inline_code_ranges(text))


def _article_split_protected(text, ranges):
    position = 0
    for start, end in ranges:
        if start > position:
            yield False, text[position:start]
        yield True, text[start:end]
        position = end
    if position < len(text):
        yield False, text[position:]


class _ArticleNormalizer:
    def __init__(self, path, root, note_index):
        self.path = Path(path)
        self.file_dir = self.path.parent
        self.root = Path(root)
        self.note_index = note_index
        self.assets = {}
        self.warnings = []
        self._attachment = ARTICLE_UNSET

    def warn(self, message):
        if message not in self.warnings:
            self.warnings.append(message)

    def normalize(self, text):
        pieces = []
        for protected, piece in _article_split_protected(text, _article_protected_ranges(text)):
            pieces.append(piece if protected else self._convert(piece))
        return "".join(pieces)

    def _convert(self, piece):
        piece = re.sub(r"%%[\s\S]*?%%", "", piece)
        piece = re.sub(r"==(.+?)==", r"**\1**", piece)
        piece = ARTICLE_EMBED_RE.sub(self._embed, piece)
        piece = ARTICLE_MD_IMAGE_RE.sub(self._md_image, piece)
        piece = ARTICLE_WIKILINK_RE.sub(self._wikilink, piece)
        return piece

    def _embed(self, match):
        target = match.group(1).strip()
        base = target.split("#")[0].strip()
        extension = Path(base).suffix.lower().lstrip(".")
        if extension in ARTICLE_IMAGE_EXTS:
            source = self._resolve_image(base)
            if source is None:
                self.warn("找不到图片: " + base)
                return match.group(0)
            name = self._store_image(source)
            if name is None:
                return match.group(0)
            return "![%s](%s)" % (Path(base).stem, name)
        return self._note_link(base, match.group(2), base)

    def _md_image(self, match):
        alt = match.group(1)
        raw = (match.group(2) if match.group(2) is not None else match.group(3) or "").strip()
        if not raw or ARTICLE_REMOTE_RE.match(raw) or raw.startswith("//"):
            return match.group(0)
        source = self._resolve_image(raw)
        if source is None:
            self.warn("找不到图片: " + raw)
            return match.group(0)
        name = self._store_image(source)
        if name is None:
            return match.group(0)
        return "![%s](%s)" % (alt, name)

    def _wikilink(self, match):
        target = match.group(1).strip()
        base = target.split("#")[0].strip()
        return self._note_link(base, match.group(2), target)

    def _note_link(self, base, alias, fallback):
        display = alias.strip() if alias and alias.strip() else base
        slug = self.note_index.get(Path(base).stem.lower())
        if slug:
            return "[%s](/articles/%s)" % (display, slug)
        return display or fallback

    def _attachment_folder(self):
        if self._attachment is not ARTICLE_UNSET:
            return self._attachment
        self._attachment = None
        config_path = self.root / ".obsidian" / "app.json"
        if config_path.is_file():
            try:
                data = json.loads(config_path.read_text())
            except (OSError, json.JSONDecodeError):
                data = {}
            value = data.get("attachmentFolderPath") if isinstance(data, dict) else None
            if isinstance(value, str) and value.strip():
                value = value.strip()
                if value in (".", "./", "/"):
                    self._attachment = self.root
                elif value.startswith("/"):
                    self._attachment = self.root / value.lstrip("/")
                else:
                    self._attachment = self.root / value
        return self._attachment

    def _resolve_image(self, raw):
        if raw.startswith("<") and raw.endswith(">"):
            raw = raw[1:-1].strip()
        try:
            decoded = urllib.parse.unquote(raw)
        except Exception:
            decoded = raw
        target = Path(decoded)
        candidates = []
        if target.is_absolute():
            candidates.append(target)
        else:
            candidates.append(self.file_dir / decoded)
            if self.root != self.file_dir:
                candidates.append(self.root / decoded)
            attachment = self._attachment_folder()
            if attachment is not None:
                candidates.append(attachment / decoded)
        for candidate in candidates:
            try:
                if candidate.is_file():
                    return candidate
            except OSError:
                pass
        wanted = target.name.lower()
        best = None
        for dirpath, dirnames, filenames in os.walk(self.root):
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            for filename in filenames:
                if filename.lower() == wanted:
                    candidate = Path(dirpath) / filename
                    if best is None or str(candidate) < str(best):
                        best = candidate
        return best

    def _store_image(self, source):
        try:
            data = source.read_bytes()
        except OSError as error:
            self.warn("读不到图片 %s: %s" % (source.name, error))
            return None
        extension = source.suffix.lower().lstrip(".")
        if extension not in ARTICLE_IMAGE_EXTS:
            self.warn("不支持的图片格式: " + source.name)
            return None
        if len(data) > ARTICLE_MAX_IMAGE_BYTES:
            compressed = self._compress_image(source)
            if compressed is None:
                self.warn("图片超过 2MB 且无法压缩，保留原样: " + source.name)
                return None
            data = compressed
            extension = "jpg"
        if extension == "jpeg":
            extension = "jpg"
        sha = hashlib.sha256(data).hexdigest()
        if sha in self.assets:
            return self.assets[sha]["name"]
        name = "images/%s.%s" % (sha[:12], extension)
        # source 记来源文件，仅供 --dry-run 的 asset 明细行使用，不进请求体与 state。
        self.assets[sha] = {"name": name, "sha256": sha, "bytes": data, "source": source}
        return name

    def _compress_image(self, source):
        if not os.path.exists(ARTICLE_SIPS):
            return None
        handle = tempfile.NamedTemporaryFile(prefix="superme-image-", suffix=".jpg", delete=False)
        handle.close()
        try:
            result = subprocess.run(
                [ARTICLE_SIPS, "-s", "format", "jpeg", "-s", "formatOptions", "80", "-Z", "2400",
                 str(source), "--out", handle.name],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
            )
            if result.returncode != 0:
                return None
            data = Path(handle.name).read_bytes()
            if len(data) <= ARTICLE_MAX_IMAGE_BYTES:
                return data
            return None
        except (OSError, subprocess.SubprocessError):
            return None
        finally:
            try:
                os.unlink(handle.name)
            except OSError:
                pass


def _article_dir_meta(path):
    """目录直接含 meta.json 且能解析成 JSON 对象 → 返回该 dict，否则 None。"""
    path = Path(path)
    meta_path = path / "meta.json"
    if not path.is_dir() or not meta_path.is_file():
        return None
    try:
        data = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _collect_article_files(target):
    """收集要推送的条目：{"file": <.md 路径>} 或 {"article_dir": <文章目录>}。

    目标本身是文章目录（直接含 meta.json）时只返回它，不遍历其中的 .md；
    遍历时遇到文章目录同样不进入其内部（里面的 .md 不单独推送）。"""
    if target.is_file():
        return [{"file": target}] if target.suffix.lower() == ".md" else []
    if _article_dir_meta(target) is not None:
        return [{"article_dir": target}]
    found = []
    for dirpath, dirnames, filenames in os.walk(target):
        walk_into = []
        for name in sorted(dirnames):
            if name.startswith("."):
                continue
            child = Path(dirpath) / name
            if _article_dir_meta(child) is not None:
                found.append({"article_dir": child})
            else:
                walk_into.append(name)
        dirnames[:] = walk_into
        for filename in sorted(filenames):
            if filename.lower().endswith(".md") and not filename.startswith("."):
                found.append({"file": Path(dirpath) / filename})
    return found


def _article_rewrite_html_images(html, article_dir, normalizer):
    """改写 article.html 里的本地 <img src="...">（双引号或单引号，大小写不限；srcset 不动）。

    src 是本地相对路径（非 http(s)://、//、data:、/ 开头、#）时相对文章目录解析（先 URL 解码，且不得跳出文章目录），
    找到文件就用 normalizer 同一个 _store_image（与正文共享 assets：去重、2MB 压缩/警告逻辑一致）
    换成 images/<sha12>.<ext>；找不到或不支持的保留原值并给警告。HTML 其余部分原样不动。
    返回 (新 html, 改写张数)。
    """
    count = 0

    def _rewrite_value(raw):
        value = raw.strip()
        if (not value or value.startswith(("#", "/"))
                or ARTICLE_REMOTE_RE.match(value) or value.lower().startswith("data:")):
            return None
        try:
            decoded = urllib.parse.unquote(value)
        except Exception:
            decoded = value
        source = Path(article_dir) / decoded
        try:
            source.resolve().relative_to(Path(article_dir).resolve())
        except (ValueError, OSError):
            normalizer.warn("图片不在文章目录内: " + value)
            return None
        try:
            exists = source.is_file()
        except OSError:
            exists = False
        if not exists:
            normalizer.warn("找不到图片: " + value)
            return None
        return normalizer._store_image(source)

    def _replace_src(match):
        nonlocal count
        prefix = match.group(1)
        quoted = match.group(2)
        new_value = _rewrite_value(quoted[1:-1])
        if new_value is None:
            return match.group(0)
        count += 1
        return prefix + quoted[0] + new_value + quoted[0]

    def _replace_tag(match):
        return ARTICLE_HTML_SRC_RE.sub(_replace_src, match.group(0))

    return ARTICLE_HTML_IMG_RE.sub(_replace_tag, html), count


def _article_relative(path, root):
    try:
        relative = os.path.relpath(str(path), str(root))
    except ValueError:
        return path.name
    return relative.replace(os.sep, "/")


def _article_dir_file(article_dir, name):
    """meta 里指定的文件名：非空字符串且解析后仍在文章目录内（不跳出目录）才返回路径，否则 None。"""
    if not isinstance(name, str):
        return None
    text = name.strip()
    if not text:
        return None
    candidate = article_dir / text
    try:
        candidate.resolve().relative_to(article_dir.resolve())
    except (ValueError, OSError):
        return None
    return candidate


def _article_dir_named_file(article_dir, value, default_name):
    """meta 指定的文件（字符串时）或默认文件名对应的路径。"""
    if isinstance(value, str) and value.strip():
        return _article_dir_file(article_dir, value)
    return article_dir / default_name


def _article_dir_read(candidate):
    """读取文本文件；不存在或读不了返回 None。"""
    if candidate is None:
        return None
    try:
        if candidate.is_file():
            return candidate.read_text(encoding="utf-8")
    except (OSError, ValueError):
        return None
    return None


def _article_dir_body_file(article_dir, meta):
    """正文回退链：meta.final → 02-final.md → meta.draft → 01-draft.md，取第一个存在的。"""
    final = _article_dir_file(article_dir, meta.get("final"))
    draft = _article_dir_file(article_dir, meta.get("draft"))
    for candidate in (final, article_dir / "02-final.md", draft, article_dir / "01-draft.md"):
        if candidate is not None and candidate.is_file():
            return candidate
    return None


def _article_dir_date(meta):
    """date = meta.brief_date，没有再 meta.date；不是 YYYY-MM-DD 就不传。"""
    value = meta.get("brief_date")
    if value is None or not str(value).strip():
        value = meta.get("date")
    if value is None:
        return None
    text = str(value).strip()
    return text if re.match(r"^\d{4}-\d{2}-\d{2}$", text) else None


def _article_dir_brief(meta):
    """brief = {date: meta.brief_date, topicId: str(meta.topic_id)}，两者都有才带。"""
    brief_date = meta.get("brief_date")
    topic_id = meta.get("topic_id")
    if not (isinstance(brief_date, str) and brief_date.strip()) or topic_id is None:
        return None
    topic_text = str(topic_id).strip()
    if not topic_text:
        return None
    return {"date": brief_date.strip(), "topicId": topic_text}


def _article_dir_board_topic_id(meta):
    """boardTopicId = meta.board_topic_id，正整数（不是 bool）才带。"""
    value = meta.get("board_topic_id")
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        return None
    return value


def _stage_label(name, round_value):
    """阶段徽标文案（设计 §4.2，与 lib/article-push.ts 的 stageLabel 一致）。"""
    if name == "drafted":
        return "初稿完成"
    if name == "revised":
        return "已按第 %s 轮改完" % ("" if round_value is None else round_value)
    if name == "rewritten":
        return "已按第 %s 轮重写" % ("" if round_value is None else round_value)
    if round_value is None:
        return "排版完成，待审"
    return "已按第 %s 轮改完排版" % round_value


def _stage_text(stage):
    """dry-run 的 stage 行：<name> round <N> · 中文标签（无 round 不带 round 段）。"""
    round_value = stage.get("round")
    round_text = "" if round_value is None else (" round %s" % round_value)
    return "%s%s · %s" % (stage.get("name", ""), round_text, _stage_label(stage.get("name"), round_value))


def _article_push_stage(stage, round_value):
    """push 的 --stage/--round → {name[, round]}；不合法就抛 ArticleError。

    只写 --round N 等同 --stage revised --round N；revised/rewritten 必须带 round。"""
    if stage is None and round_value is None:
        return None
    name = "revised" if stage is None else str(stage).strip().lower()
    if name not in ARTICLE_STAGE_NAMES:
        raise ArticleError("--stage 只能是 drafted、revised、rewritten 或 typeset")
    if round_value is None:
        if name in ("revised", "rewritten"):
            raise ArticleError("--stage %s 必须带 --round（第几轮审稿）" % name)
        return {"name": name}
    return {"name": name, "round": round_value}


def _article_cover_file(article_dir, prefix):
    """images/<prefix>.<ext>：按 png/jpg/jpeg/webp 顺序取第一个存在的。"""
    for extension in ARTICLE_COVER_EXTS:
        candidate = article_dir / "images" / (prefix + "." + extension)
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            pass
    return None


def _article_dir_covers(article_dir, meta):
    """封面来源清单（设计 §4.3，仅文章目录）：返回 ([{role, source}], [warning])。

    images/cover-21x9.* 与 images/cover-1x1.* 自动发现；meta.cover 显式指定时优先
    （字符串 = role cover，对象 = {21x9/1x1/cover: 路径}）。路径相对文章目录，
    越出目录或找不到的条目给 warning 并忽略。同一文件可能占多个 role，去重交给 _store_image。"""
    article_dir = Path(article_dir)
    sources = []
    warnings = []
    meta_covers = {}
    value = meta.get("cover")
    if value is not None:
        entries = []
        if isinstance(value, str):
            entries.append(("cover", value))
        elif isinstance(value, dict):
            for role in ("21x9", "1x1", "cover"):
                if value.get(role) is not None:
                    entries.append((role, value.get(role)))
        else:
            warnings.append("meta.cover 只能是字符串或 {21x9, 1x1, cover} 对象，忽略")
        for role, path_value in entries:
            if not isinstance(path_value, str) or not path_value.strip():
                warnings.append("meta.cover 的 %s 路径不合法，忽略" % role)
                continue
            text = path_value.strip()
            try:
                (article_dir / text).resolve().relative_to(article_dir.resolve())
            except (ValueError, OSError):
                warnings.append("封面 %s 不在文章目录内: %s，忽略" % (role, text))
                continue
            meta_covers[role] = article_dir / text
    for role, prefix in (("21x9", "cover-21x9"), ("1x1", "cover-1x1")):
        source = meta_covers.pop(role, None)
        if source is None:
            source = _article_cover_file(article_dir, prefix)
        if source is None:
            continue
        if not source.is_file():
            warnings.append("封面 %s 找不到: %s，忽略" % (role, source.name))
            continue
        sources.append({"role": role, "source": source})
    if "cover" in meta_covers:
        source = meta_covers["cover"]
        if not source.is_file():
            warnings.append("封面 cover 找不到: %s，忽略" % source.name)
        else:
            sources.append({"role": "cover", "source": source})
    return sources, warnings


def _article_dir_slug(article_dir, meta, body_path, title, state_files):
    """文章目录的 slug：meta.slug > 目录名（合法时）> state 里记录的 slug > 由标题生成。"""
    value = meta.get("slug")
    if value is not None and str(value).strip():
        slug = str(value).strip()
        if not ARTICLE_SLUG_RE.match(slug):
            raise ArticleError("slug 不合法: %r（需匹配 [A-Za-z0-9][A-Za-z0-9._-]{0,120}）" % slug)
        return slug
    if ARTICLE_SLUG_RE.match(article_dir.name):
        return article_dir.name
    record = state_files.get(str(body_path))
    if record and record.get("slug"):
        return record["slug"]
    return _article_generate_slug(title, article_dir.name + "/" + body_path.name)


def _article_dir_entry(article_dir, meta, state_files):
    """文章目录（meta.json）→ 一篇文章的 entry。

    正文照旧解析 frontmatter（tags 生效），status 固定 draft（meta.json 里的 status 不是协议状态，忽略）；
    article_html / qa_report 存原文（html 图片改写由 _article_rewrite_html_images 在归一正文后做）；
    state 记录键仍是正文文件的绝对路径，rel（sourcePath）= <目录名>/<正文文件名>。"""
    article_dir = Path(article_dir)
    body_path = _article_dir_body_file(article_dir, meta)
    if body_path is None:
        raise ArticleError("找不到正文（02-final.md / 01-draft.md）")
    text = _article_dir_read(body_path)
    if text is None:
        raise ArticleError("读不到正文 " + body_path.name)
    fm_meta, body = _parse_frontmatter(text)
    title = meta.get("title")
    if title is None or not str(title).strip():
        title = _article_title(fm_meta, body, body_path)
    else:
        title = str(title).strip()
    layout = meta.get("layout")
    html_name = layout.get("html") if isinstance(layout, dict) else None
    cover_specs, cover_warnings = _article_dir_covers(article_dir, meta)
    return {
        "file": body_path,
        "rel": article_dir.name + "/" + body_path.name,
        "article_dir": article_dir,
        "meta": fm_meta,
        "body": body,
        "title": title,
        "slug": _article_dir_slug(article_dir, meta, body_path, title, state_files),
        "status": "draft",
        "date": _article_dir_date(meta),
        "article_html": _article_dir_read(_article_dir_named_file(article_dir, html_name, "article.html")),
        "qa_report": _article_dir_read(_article_dir_named_file(article_dir, meta.get("qa_report"), "qa-report.md")),
        "board_topic_id": _article_dir_board_topic_id(meta),
        "brief": _article_dir_brief(meta),
        "cover_specs": cover_specs,
        "cover_warnings": cover_warnings,
    }


def _article_http(method, path, body=None, assistant=False, token_chain=None):
    url = endpoint() + path
    headers = {
        "Content-Type": "application/json",
        "Origin": endpoint(),
        "Referer": endpoint() + "/",
        "User-Agent": "superme-cli/" + CLI_VERSION,
    }
    if token_chain is not None:
        # 自定义链（如 brief 只读）：环境变量依次取，再退回 config token。
        token = _env_token(*token_chain) or load_config().get("token")
    elif assistant:
        # 助手模式只用助手 token（SUPERME_TOKEN > DABAIHUA_CARDS_ASSISTANT_TOKEN > HANDBOOK_TOKEN），不用 config。
        token = _env_token("SUPERME_TOKEN", "DABAIHUA_CARDS_ASSISTANT_TOKEN", "HANDBOOK_TOKEN")
    else:
        token = _env_token("SUPERME_TOKEN") or load_config().get("token")
    if token:
        headers["Authorization"] = "Bearer " + token
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=120) as response:
            raw = response.read().decode("utf-8")
            return response.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8")
        try:
            payload = json.loads(raw)
        except (ValueError, TypeError):
            payload = {"error": raw[:200]}
        return error.code, payload
    except urllib.error.URLError as error:
        raise ArticleError("连不上 %s: %s" % (endpoint(), error.reason))


def _article_uploaded_assets(state_files, slug):
    uploaded = {}
    for record in state_files.values():
        if record.get("slug") == slug:
            for name, sha in (record.get("assets") or {}).items():
                uploaded[name] = sha
    return uploaded


def _article_dry_run_assets(entry, assets, state_files, entry_root):
    """--dry-run 的 asset 明细行（文章目录模式）。

    每行：images/<sha12>.<ext> ← <本地相对文件名> <KB> 上传|已上传（按 state 里该 slug 的记录判断）。
    """
    uploaded = _article_uploaded_assets(state_files, entry["slug"])
    lines = []
    for asset in sorted(assets, key=lambda item: item["name"]):
        source = asset.get("source")
        source_text = _article_relative(source, entry_root) if source else asset["name"]
        try:
            size = "%.1f KB" % (len(asset["bytes"]) / 1024)
        except (KeyError, TypeError):
            size = "?"
        state_text = "已上传" if uploaded.get(asset["name"]) == asset["sha256"] else "上传"
        lines.append("  %s ← %s %s %s" % (asset["name"], source_text, size, state_text))
    return lines


def _article_push_one(entry, assets, state_files, assistant=None):
    slug = entry["slug"]
    uploaded = _article_uploaded_assets(state_files, slug)
    payload_assets = []
    for asset in assets:
        item = {"name": asset["name"], "sha256": asset["sha256"]}
        if uploaded.get(asset["name"]) != asset["sha256"]:
            item["base64"] = base64.b64encode(asset["bytes"]).decode("ascii")
        payload_assets.append(item)
    body = {
        "protocol": ARTICLE_PROTOCOL,
        "title": entry["title"],
        "markdown": entry["markdown"],
        "status": entry["status"],
        "tags": entry["tags"],
        "sourcePath": entry["rel"],
        "contentHash": entry["contentHash"],
        "assets": payload_assets,
    }
    if entry["is_public"] is not None:
        body["isPublic"] = entry["is_public"]
    if entry["date"]:
        body["date"] = entry["date"]
    # 扩展字段（协议 §3）：entry 里没有就不传；assistant 不参与 contentHash。
    if entry.get("article_html"):
        body["articleHtml"] = entry["article_html"]
    if entry.get("qa_report"):
        body["qaReport"] = entry["qa_report"]
    if entry.get("board_topic_id") is not None:
        body["boardTopicId"] = entry["board_topic_id"]
    if entry.get("brief"):
        body["brief"] = entry["brief"]
    # 阶段写回（设计 §4.2）：请求体原样传 {name[, round]}，无 round 不带 round 键。
    if entry.get("stage"):
        body["stage"] = entry["stage"]
    # 封面（设计 §4.3）：[{role, path}]，path = 资产名 images/<sha12>.<ext>。
    if entry.get("covers"):
        body["covers"] = entry["covers"]
    if assistant:
        body["assistant"] = assistant
    path = "/api/articles/" + urllib.parse.quote(slug)
    try:
        status, response = _article_http("PUT", path, body, assistant=assistant)
    except ArticleError as error:
        print("失败 %s: %s" % (slug, error))
        return True
    if status == 422:
        missing = [name for name in (response.get("missingAssets") or []) if name]
        if missing:
            by_name = {asset["name"]: asset for asset in assets}
            for item in payload_assets:
                if item["name"] in missing and "base64" not in item:
                    asset = by_name.get(item["name"])
                    if asset is not None:
                        item["base64"] = base64.b64encode(asset["bytes"]).decode("ascii")
            try:
                status, response = _article_http("PUT", path, body, assistant=assistant)
            except ArticleError as error:
                print("失败 %s: %s" % (slug, error))
                return True
    if status in (200, 201):
        result = response.get("result") or ("created" if status == 201 else "updated")
        print("%s %s · %s" % (slug, result, entry["title"]))
        if entry.get("stage"):
            print("已标记：%s" % _stage_label(entry["stage"].get("name"), entry["stage"].get("round")))
        record = state_files.setdefault(str(entry["file"]), {})
        record["slug"] = slug
        record["contentHash"] = entry["contentHash"]
        record["assets"] = {asset["name"]: asset["sha256"] for asset in assets}
        record["pushedAt"] = datetime.now(timezone.utc).isoformat()
        return False
    code = response.get("code") or ""
    message = response.get("error") or code or ("HTTP %s" % status)
    if status == 401:
        if assistant:
            print("失败 %s: 助手 token 无效或已失效（检查 HANDBOOK_TOKEN）" % slug)
        else:
            print("失败 %s: 未登录或 Key 已失效（先跑 superme login）" % slug)
    elif status == 403 and code == "assistant_draft_only":
        print("失败 %s: 助手只能推送草稿，不能发布或公开" % slug)
    elif status == 409 and code == "slug_taken":
        print("失败 %s: slug 已被其他账号占用，请在 frontmatter 里换一个 slug，例如 slug: %s-2" % (slug, slug))
    elif status == 409 and code == "slug_managed":
        print("失败 %s: 该 slug 由服务器目录导入管理，请在 frontmatter 里换一个 slug" % slug)
    elif status == 409 and code == "article_locked":
        detail = "审稿通过后只能用 --stage typeset 推排版" if (response.get("status") == "approved") else "先在站点上处理"
        print("失败 %s: 文章已锁定为非草稿状态（当前状态: %s），助手不能覆盖，%s" % (
            slug, response.get("status") or "未知", detail))
    elif status == 422 and code == "round_not_reviewed":
        print("失败 %s: %s，不能标记阶段" % (slug, message))
    elif status == 422 and code == "assistant_required":
        print("失败 %s: 助手 token 推送需要 --assistant 助手名字" % slug)
    elif status == 503 and code == "owner_unavailable":
        print("失败 %s: 文章归属账号不可用，请联系管理员" % slug)
    else:
        print("失败 %s: %s" % (slug, message))
    return True


def _cmd_article_list():
    try:
        status, response = _article_http("GET", "/api/articles")
    except ArticleError as error:
        sys.exit(str(error))
    if status != 200:
        sys.exit("服务器返回 %s: %s" % (status, response.get("error") or ""))
    rows = response.get("articles") or response.get("items") or []
    if not rows:
        print("（还没有文章）")
        return 0
    for row in rows:
        public = "公开" if row.get("isPublic") else "私密"
        print("%-40s %s · %s · %s" % (
            row.get("slug", ""), row.get("title") or "", public, str(row.get("date") or "")[:10],
        ))
    return 0


FEEDBACK_NOT_FOUND = "还没有找到这篇文章的审稿反馈（slug 或轮次不对，或还没提交审稿）"

_FEEDBACK_VERDICT_LABELS = {
    "approved": "确认通过",
    "changes_requested": "要求修改",
    "comments": "批注",
}


def _feedback_quote(mark):
    """默认摘要里的 quote：超过 120 字截断加省略号（--json 不截断）。"""
    quote = str(mark.get("quote") or "")
    if len(quote) > 120:
        quote = quote[:120] + "…"
    return quote


def _feedback_print_group(label, marks):
    print("%s（%d）" % (label, len(marks)))
    for index, mark in enumerate(marks, 1):
        print("  %d. 「%s」" % (index, _feedback_quote(mark)))
        comment = str(mark.get("comment") or "").strip()
        print("     → %s" % (comment or "（未写意见）"))


def _cmd_article_feedback(args):
    slug = str(args.path or "").strip()
    if not slug:
        sys.exit("用法: superme article feedback <slug> [--round N] [--json] [--assistant 名字]")
    assistant = _article_assistant_name(args)
    path = "/api/review/article/" + urllib.parse.quote(slug, safe="") + "/feedback"
    if args.round:
        path += "?round=" + urllib.parse.quote(str(args.round), safe="")
    try:
        status, response = _article_http("GET", path, assistant=bool(assistant))
    except ArticleError as error:
        sys.exit(str(error))
    if status == 401:
        if assistant:
            sys.exit("助手 token 无效或已失效（检查 HANDBOOK_TOKEN）")
        sys.exit("未登录或 Key 已失效（先跑 superme login）")
    if status == 404:
        sys.exit(FEEDBACK_NOT_FOUND)
    if status != 200:
        sys.exit("服务器返回 %s: %s" % (status, response.get("error") or ""))
    feedback = response.get("feedback")
    if not feedback:
        sys.exit(FEEDBACK_NOT_FOUND)
    if getattr(args, "json", False):
        print(json.dumps(feedback, ensure_ascii=False, indent=2))
        return 0
    target = feedback.get("target") or {}
    title = target.get("title") or slug
    verdict = _FEEDBACK_VERDICT_LABELS.get(feedback.get("verdict"), feedback.get("verdict") or "未知")
    reviewer = (feedback.get("reviewer") or {}).get("nickname") or "未知"
    print("《%s》 第 %s 轮 · %s   审稿人 %s · %s" % (
        title, feedback.get("round") if feedback.get("round") is not None else "—",
        verdict, reviewer, _feedback_local_time(feedback.get("submittedAt"))))
    overall = str(feedback.get("overallComment") or "").strip()
    print("总体意见：%s" % (overall or "（无）"))
    marks = [mark for mark in (feedback.get("marks") or []) if isinstance(mark, dict)]
    _feedback_print_group("要改", [mark for mark in marks if mark.get("type") == "change"])
    _feedback_print_group("写得好", [mark for mark in marks if mark.get("type") == "good"])
    print("contentHash: %s" % (feedback.get("contentHash") or "—"))
    return 0


def _article_default_root(target):
    """没给 --root 时：从目标往上找 Obsidian 库根（含 .obsidian 目录）；找不到就用目标目录本身。
    这样单独推送库里的一篇笔记，也能找到库里别处的附件。"""
    start = target if target.is_dir() else target.parent
    for candidate in [start] + list(start.parents):
        if (candidate / ".obsidian").is_dir():
            return candidate
    return start


ASSISTANT_TOKEN_HINT = (
    "助手推送需要助手 token：先 set -a; . ~/.config/handbook/env; set +a，"
    '再用 SUPERME_TOKEN="$HANDBOOK_TOKEN"'
)


def _article_assistant_name(args):
    """--assistant 或环境变量 SUPERME_ASSISTANT 给出的助手名字；没有则 None。"""
    value = getattr(args, "assistant", None) or os.environ.get("SUPERME_ASSISTANT") or ""
    name = str(value).strip()
    if not name:
        return None
    if len(name) > 20:
        sys.exit("助手名字需 1-20 个字符，得到 %d 个: %s" % (len(name), name))
    return name


def _cmd_article_push(args, sync):
    if not args.path:
        sys.exit("用法: superme article %s <文件|目录> [--dry-run]" % ("sync" if sync else "push"))
    target = Path(args.path).expanduser()
    if not target.exists():
        sys.exit("找不到: " + str(target))
    target = target.resolve()
    assistant = _article_assistant_name(args)
    if assistant and args.public:
        sys.exit("--assistant 与 --public 不能同时使用（助手只能推草稿）")
    # --dry-run 不联网，助手模式此时不需要 token。
    if assistant and not args.dry_run and not _env_token(
            "SUPERME_TOKEN", "DABAIHUA_CARDS_ASSISTANT_TOKEN", "HANDBOOK_TOKEN"):
        sys.exit(ASSISTANT_TOKEN_HINT)
    # --stage/--round 校验（设计 §4.2）：不联网，出错直接退。
    try:
        stage = _article_push_stage(getattr(args, "stage", None), getattr(args, "round", None))
    except ArticleError as error:
        sys.exit(str(error))
    args_root = Path(args.root).expanduser().resolve() if args.root else None
    if args_root is not None and not args_root.exists():
        sys.exit("找不到根目录: " + str(args_root))
    base_root = args_root or _article_default_root(target)
    items = _collect_article_files(target)
    if not items:
        print("（没有 .md 文件）")
        return 0
    state = _article_state_load()
    state_files = _article_state_files(state)
    entries = []
    for item in items:
        if "article_dir" in item:
            # 文章目录（meta.json）：一整个目录是一篇文章，里面的其它 .md 不推。
            article_dir = item["article_dir"]
            dir_meta = _article_dir_meta(article_dir)
            if dir_meta is None:
                continue
            try:
                entries.append(_article_dir_entry(article_dir, dir_meta, state_files))
            except ArticleError as error:
                print("跳过 %s: %s" % (article_dir.name, error))
            continue
        path = item["file"]
        try:
            text = path.read_text(encoding="utf-8")
        except OSError as error:
            print("跳过 %s: 读取失败 %s" % (path.name, error))
            continue
        meta, body = _parse_frontmatter(text)
        title = _article_title(meta, body, path)
        rel = _article_relative(path, base_root)
        if meta.get("publish") is False:
            print("跳过 %s: publish: false" % rel)
            continue
        try:
            slug = _article_resolve_slug(meta, title, rel, path, state_files)
            status = _article_status(meta)
            date = _article_date(meta)
        except ArticleError as error:
            print("跳过 %s: %s" % (rel, error))
            continue
        entries.append({
            "file": path, "rel": rel, "meta": meta, "body": body,
            "title": title, "slug": slug, "status": status, "date": date,
        })
    if not entries:
        return 0
    if stage is not None and len(entries) > 1:
        sys.exit("--stage/--round 只能用于单篇文章")
    note_index = {}
    for abs_key, record in state_files.items():
        if record.get("slug"):
            note_index[Path(abs_key).stem.lower()] = record["slug"]
    for entry in entries:
        note_index[entry["file"].stem.lower()] = entry["slug"]
    failed = 0
    unchanged = 0
    for entry in entries:
        # 文章目录默认 root = 目录本身（--root 仍可覆盖），找图不遍历上级大目录。
        if "article_dir" in entry and args_root is None:
            entry_root = entry["article_dir"]
        else:
            entry_root = base_root
        normalizer = _ArticleNormalizer(entry["file"], entry_root, note_index)
        entry["markdown"] = normalizer.normalize(entry["body"])
        # 正文归一后再改写 html：与正文共享同一个 normalizer 的 assets。
        entry["html_images"] = 0
        if entry.get("article_html"):
            entry["article_html"], entry["html_images"] = _article_rewrite_html_images(
                entry["article_html"], entry["article_dir"], normalizer)
        # 封面（§4.3）：复用正文归一的资产存储（去重 / 2MB / 格式限制），
        # 必须在取 assets 快照前解析，同一文件只存一份。仅文章目录模式有 cover_specs。
        entry["stage"] = stage
        entry["covers"] = []
        for warning in entry.get("cover_warnings") or []:
            normalizer.warn(warning)
        for spec in entry.get("cover_specs") or []:
            cover_name = normalizer._store_image(spec["source"])
            if cover_name is not None:
                entry["covers"].append({"role": spec["role"], "path": cover_name})
        assets = list(normalizer.assets.values())
        entry["tags"] = _article_tags(entry["meta"])
        if assistant:
            # 助手只能写草稿：frontmatter 里的 published / public 忽略（给警告），不传 isPublic。
            if entry["status"] == "published":
                print("警告 %s: 助手模式忽略 status: published，固定为 draft" % entry["rel"])
            if entry["meta"].get("public") is True:
                print("警告 %s: 助手模式忽略 public: true" % entry["rel"])
            entry["status"] = "draft"
            entry["is_public"] = None
        elif "article_dir" in entry:
            # 文章目录固定 draft；--public（非助手）时 is_public=True。
            entry["is_public"] = True if args.public else None
        else:
            entry["is_public"] = _article_is_public(entry["meta"], entry["status"], args.public)
        entry["contentHash"] = _article_content_hash(
            entry["title"], entry["status"], entry["is_public"], entry["date"],
            entry["tags"], assets, entry["markdown"],
            article_html=entry.get("article_html"), qa_report=entry.get("qa_report"),
            board_topic_id=entry.get("board_topic_id"), brief=entry.get("brief"),
            stage=stage, covers=entry.get("covers"),
        )
        cached = state_files.get(str(entry["file"])) or {}
        changed = cached.get("contentHash") != entry["contentHash"]
        if sync and not changed:
            print("%s 未变化" % entry["slug"])
            unchanged += 1
            continue
        if args.dry_run:
            public_text = "公开" if entry["is_public"] is True else ("私密" if entry["is_public"] is False else "默认")
            changed_text = "已变化" if changed else "未变化"
            if "article_dir" in entry:
                # 文章目录模式逐项打印（§6）：字段、article.html 改写数、asset 明细、全部警告。
                print("%s · %s · %s" % (entry["slug"], entry["title"], changed_text))
                print("  状态: %s/%s" % (entry["status"], public_text))
                print("  日期: %s" % (entry["date"] or "—"))
                print("  正文: %s" % entry["rel"])
                if entry.get("article_html"):
                    print("  article.html: 有（改写 %d 张图）" % entry.get("html_images", 0))
                else:
                    print("  article.html: 无")
                print("  qa-report: %s" % ("有" if entry.get("qa_report") else "无"))
                if entry.get("brief"):
                    print("  brief: %s · %s" % (entry["brief"].get("date", ""), entry["brief"].get("topicId", "")))
                if entry.get("board_topic_id") is not None:
                    print("  boardTopicId: %s" % entry["board_topic_id"])
                if entry.get("stage"):
                    print("  stage: %s" % _stage_text(entry["stage"]))
                for cover in entry.get("covers") or []:
                    print("  封面 %s: %s" % (cover.get("role", ""), cover.get("path", "")))
                if assistant:
                    print("  assistant: %s" % assistant)
                for line in _article_dry_run_assets(entry, assets, state_files, entry_root):
                    print(line)
            else:
                # 单文件模式保持原有的一行式输出。
                print("%s · %s · %s/%s · 图片 %d · %s" % (
                    entry["slug"], entry["title"], entry["status"], public_text, len(assets), changed_text,
                ))
                if entry.get("stage"):
                    print("  stage: %s" % _stage_text(entry["stage"]))
            for warning in normalizer.warnings:
                print("  警告: " + warning)
            continue
        if _article_push_one(entry, assets, state_files, assistant):
            failed += 1
    if not args.dry_run:
        _article_state_save(state)
    if unchanged:
        print("未变化 %d 篇" % unchanged)
    return 1 if failed else 0


