def cmd_retro(args):
    """复盘命令"""
    sub = getattr(args, "sub", None)

    # --- new: 新建复盘 ---
    if sub == "new":
        if not args.date or not args.title or not args.problem or not args.result or not args.lesson:
            sys.exit("用法: superme retro new --date YYYY-MM-DD --title ... --problem ... --result ... --lesson ...")
        body = {
            "date": args.date,
            "title": args.title,
            "problem": args.problem,
            "result": args.result,
            "lesson": args.lesson,
        }
        if args.series:
            body["relatedSeries"] = args.series
        if args.topics:
            body["relatedTopicIds"] = [int(x.strip()) for x in args.topics.split(",") if x.strip()]
        r = request("/api/retrospectives", "POST", body)
        print(f"✅ 复盘 #{r.get('id')} 已创建")
        return

    # --- revise: 修订复盘 ---
    if sub == "revise":
        if not args.id:
            sys.exit("用法: superme retro revise <id> --lesson \"新教训\"")
        body = {}
        if args.lesson is not None:
            body["lesson"] = args.lesson
        if args.result is not None:
            body["result"] = args.result
        if args.problem is not None:
            body["problem"] = args.problem
        if not body:
            sys.exit("至少指定 --lesson / --result / --problem 之一")
        r = request(f"/api/retrospectives/{args.id}", "POST", body)
        print(f"✅ 复盘 #{args.id} 已修订")
        return

    # --- history: 按标题查历史 ---
    if sub == "history":
        if not args.title:
            sys.exit("用法: superme retro history --title \"...\"")
        data = request(f"/api/retrospectives/0?title={urllib.parse.quote(args.title)}")
        versions = data.get("versions") or data.get("history") or [data]
        for v in versions:
            print(f"  v{v.get('version', '?')}  {v.get('date', '')[:10]}  {v.get('title', '')[:40]}")
            if v.get("lesson"):
                print(f"        教训: {v['lesson'][:60]}")
        return

    # --- 默认: 列出复盘 ---
    qs = "?history=1" if args.history else ""
    data = request(f"/api/retrospectives{qs}")
    items = data.get("retrospectives") or data.get("data") or []
    if not items:
        print("（还没有复盘记录）")
        return
    for r in items:
        active = "← 当前" if r.get("isActive") else ""
        print(f"  #{r.get('id', '?'):<3} v{r.get('version', '?')}  {r.get('date', '')[:10]}  {r.get('title', '')[:40]} {active}")
        if r.get("lesson"):
            print(f"        教训: {r['lesson'][:60]}")
    print(f"\n共 {len(items)} 条 · superme retro new 创建 · superme retro revise <id> 修订")


