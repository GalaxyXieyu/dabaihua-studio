    # 无参数: 列出所有系列
    rows = request("/api/series").get("series") or request("/api/series").get("data") or []
    if not rows:
        print("（还没有系列）")
        return
    for s in rows:
        print(f"  {s.get('name', ''):<24} {s.get('topicCount', 0)} 篇 · {s.get('description', '')[:40]}")


