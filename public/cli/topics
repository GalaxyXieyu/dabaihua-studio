        else:
            print("%s: updated · %s · %s" % (name, _data_summary_text(name, response.get("summary") or local_summary), _data_size(response.get("bytes"))))
        return 0
    code = response.get("code") or ""
    message = response.get("error") or code or ("HTTP %s" % status)
    sys.exit("%s: %s · %s" % (name, code or "error", message))


