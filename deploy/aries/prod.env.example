# Aries prod.env 示例（真实文件在 /home/ubuntu/dabaihua-data/prod.env，chmod 600，绝不入库）
# KEY=VALUE，每行一个；`#` 开头与空行会被忽略。

# 素材导入等写操作的长期 token（必填）
IMPORT_TOKEN=replace-with-a-random-secret

# 可信反向代理主机（Caddy 域名），逗号分隔
DABAIHUA_TRUSTED_PROXY_HOSTS=topic.example.com,superme.example.com

# 是否允许注册；1 表示开放（可选）
DABAIHUA_ALLOW_REGISTER=1

# 注册邀请码（可选，留空则不校验）
DABAIHUA_REGISTER_INVITE_CODE=replace-with-an-invite-code

# 对外公开基础 URL，周报与简报通知里的链接用（可选，默认取请求 origin）
DABAIHUA_PUBLIC_BASE_URL=https://superme.example.com

# 照照镜子 / 漱芳斋写作助手共用的 Bearer token（可选，由 Yu 分发）
DABAIHUA_CARDS_ASSISTANT_TOKEN=replace-with-a-random-secret

# 漱芳斋写作助手的入站 webhook 地址（可选；不配置则通知状态为 unconfigured）
SHUFANGZHAI_WEBHOOK_URL=https://shufangzhai.example.com/hooks/dabaihua

# webhook 鉴权密钥（可选，配合下面的 header）
SHUFANGZHAI_WEBHOOK_SECRET=replace-with-a-random-secret

# 鉴权 header 名（可选，默认 Authorization；默认时值为 Bearer <secret>，
# 自定义 header 时值为原始 secret）
# 需要自定义时才取消注释，例如：
# SHUFANGZHAI_WEBHOOK_AUTH_HEADER=Authorization
